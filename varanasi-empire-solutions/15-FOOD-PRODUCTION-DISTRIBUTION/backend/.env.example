# Server Configuration
NODE_ENV=development
PORT=5015
API_VERSION=v1

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=food_production_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-food-production-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
UPLOAD_MAX_SIZE=5242880
UPLOAD_DIR=./uploads

# Email Configuration (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@foodproduction.com
FROM_NAME=Food Production System

# SMS Configuration (MSG91)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=FDPROD

# WhatsApp Configuration (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# IoT & Sensors Configuration
COLD_CHAIN_API_URL=http://localhost:8080
TEMP_SENSOR_ALERT_MIN=2
TEMP_SENSOR_ALERT_MAX=8
HUMIDITY_ALERT_MIN=60
HUMIDITY_ALERT_MAX=70

# Business Settings
BUSINESS_NAME=Food Production Company
TIMEZONE=Asia/Kolkata
CURRENCY=INR
GST_NUMBER=
FSSAI_LICENSE=

# Quality Control
QC_PASS_THRESHOLD=80
QC_ALERT_EMAILS=qc@company.com,manager@company.com

# Batch Settings
BATCH_NUMBER_PREFIX=FP
DEFAULT_SHELF_LIFE_DAYS=30

# Inventory Alerts
LOW_STOCK_THRESHOLD=100
REORDER_POINT_DAYS=7

# Distribution Settings
DELIVERY_RADIUS_KM=50
MIN_ORDER_AMOUNT=1000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log
