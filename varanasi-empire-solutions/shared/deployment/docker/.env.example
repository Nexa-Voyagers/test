# Docker Compose Environment Variables
# Copy this file to .env and configure for your deployment

# Solution Name (used as container prefix)
SOLUTION_NAME=restaurant-pos

# Application Settings
APP_NAME=Restaurant POS Management
NODE_ENV=production

# Database Configuration
DB_NAME=restaurant_pos_db
DB_USER=postgres
DB_PASSWORD=StrongPassword123!
DB_PORT=5432

# Redis Configuration
REDIS_PASSWORD=RedisPassword123!
REDIS_PORT=6379

# Backend Configuration
BACKEND_PORT=5000
JWT_SECRET=your-very-strong-jwt-secret-key-min-32-characters-long
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-refresh-token-secret-key-also-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_NAME=Restaurant POS

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,https://yourdomain.com

# Nginx Configuration
HTTP_PORT=80
HTTPS_PORT=443

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email Configuration (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Restaurant POS

# SMS Configuration (MSG91)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=RSTPOS

# WhatsApp Configuration (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# OTA Integration (if applicable)
SWIGGY_API_KEY=your_swiggy_api_key
ZOMATO_API_KEY=your_zomato_api_key

# Business Settings
BUSINESS_NAME=Your Business Name
TIMEZONE=Asia/Kolkata
CURRENCY=INR
GST_NUMBER=
FSSAI_LICENSE=

# Logging
LOG_LEVEL=info
