# Server Configuration
NODE_ENV=development
PORT=5016
API_VERSION=v1

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=transport_logistics_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-transport-logistics-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
UPLOAD_MAX_SIZE=5242880
UPLOAD_DIR=./uploads

# Email Configuration
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@transport-logistics.com
FROM_NAME=Transport & Logistics System

# SMS Configuration
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=TRNLOG

# GPS Tracking Configuration
GPS_API_URL=http://localhost:8080
GPS_UPDATE_INTERVAL=60000
GEOFENCE_RADIUS_KM=0.5

# Business Settings
BUSINESS_NAME=Transport & Logistics Company
TIMEZONE=Asia/Kolkata
CURRENCY=INR
GST_NUMBER=
PAN_NUMBER=

# Fuel Management
FUEL_PRICE_PER_LITER=105.50
FUEL_ALERT_THRESHOLD=20

# Maintenance Alerts
MAINTENANCE_KM_THRESHOLD=5000
MAINTENANCE_DAYS_THRESHOLD=90

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log
