# Server Configuration
NODE_ENV=development
PORT=5003
API_VERSION=v1

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=travel_tour_agency
DB_USER=postgres
DB_PASSWORD=your_password
DB_MAX_CONNECTIONS=20

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_for_travel
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=2

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@travelagency.com

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Flight/Train API (Optional integrations)
IRCTC_API_URL=https://api.irctc.com
IRCTC_API_KEY=your_irctc_api_key
FLIGHT_API_URL=https://api.flight.com
FLIGHT_API_KEY=your_flight_api_key

# Hotel Booking API
HOTEL_API_URL=https://api.hotels.com
HOTEL_API_KEY=your_hotel_api_key

# Visa Services
VISA_PROCESSING_FEE=2000

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logs
LOG_LEVEL=info
LOG_FILE_PATH=./logs
