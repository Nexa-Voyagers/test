# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=restaurant_pos_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-restaurant-pos-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
UPLOAD_MAX_SIZE=5242880
UPLOAD_DIR=./uploads

# Email Configuration (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@restaurant-pos.com
FROM_NAME=Restaurant POS

# SMS Configuration (MSG91)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=RSTPOS

# WhatsApp Configuration (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# OTA Integration
SWIGGY_API_KEY=your_swiggy_api_key
ZOMATO_API_KEY=your_zomato_api_key

# Business Settings
BUSINESS_NAME=Your Restaurant Name
TIMEZONE=Asia/Kolkata
CURRENCY=INR
GST_NUMBER=
FSSAI_LICENSE=

# Tax Settings
DEFAULT_CGST_RATE=2.5
DEFAULT_SGST_RATE=2.5
DEFAULT_SERVICE_CHARGE=10

# Kitchen Display Settings
KDS_REFRESH_INTERVAL=5000
KDS_AUTO_ACCEPT_ORDERS=false

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log
